# Copy this file to .env (or just run: php database/setup.php)
APP_NAME=OrMindoroHR
APP_KEY=
APP_ENV=development

# Database (MySQL / MariaDB, e.g. XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=ormindoro_hr
# Optional CA certificate path for managed MySQL services such as Aiven.
DB_SSL_CA=

# JWT secrets - at least 32 characters each. setup.php fills these in for you.
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Frontend origin(s) allowed to call the API, comma separated
ALLOW_ORIGIN=http://localhost:5173

# Sign-in codes (OTP) for HR, Accounting, MIS and Admin. Set to false to turn off.
OTP_ENABLED=true

# Notifications are always written to runtime/outbox.log. Optionally also deliver them:
MAIL_ENABLED=false
MAIL_FROM=no-reply@ormindoro.local
# POST {"to":"+63...","message":"..."} to this URL to send SMS through your provider's gateway
SMS_WEBHOOK_URL=
